[Unit]
Description=Kensington SlimBlade trackball remapper
Documentation=https://github.com/ioloryn/slimblade
After=graphical-session.target

[Service]
Type=simple
# Adjust if you installed the binary somewhere else (for example /usr/bin).
ExecStart=%h/.cargo/bin/slimblade run
Restart=on-failure
RestartSec=1
# Environment=RUST_LOG=info

[Install]
WantedBy=default.target
